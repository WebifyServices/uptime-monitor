{
  "name": "uptime-monitor",
  "version": "0.1.0",
  "description": "A small self-hosted uptime monitor with incidents, alerts and a public status page",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
