    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.0",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@12.23.0"
}
